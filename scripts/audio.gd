class_name AudioDirector
extends Node
## Game audio: Master / Music / Ambience / SFX buses, ambience beds that
## crossfade with what the camera is looking at (forest, meadow, coast, high
## wind when zoomed out), occasional settlement work and murmur, sparse
## wildlife, God Hand and divine-power cues, an optional quiet music bed, and
## the volume settings (saved to user://audio.cfg). All sounds are original
## and procedurally generated by tools/make_audio.py (see AUDIO_CREDITS.md).

const BUSES := ["Music", "Ambience", "SFX"]
const DEFAULTS := {"Master": 0.85, "Music": 0.45, "Ambience": 0.8, "SFX": 0.85}
const CFG_PATH := "user://audio.cfg"
const VOICES := 18
## concurrent voices per category (anything beyond is skipped, not queued)
const LIMITS := {"settle": 3, "bird": 2, "wild": 2, "hand": 3, "power": 6, "fire": 3, "ui": 2}
## per-layer gain (dB) on top of the weight-driven fades
const AMB_LAYERS := {"forest": -3.0, "meadow": -2.0, "coast": -2.5, "high_wind": -5.0}
const MUSIC := ["dawn_of_valleys", "quiet_shores"]

var main
var sim: WorldSim
var terrain: Terrain
var rig: CameraRig
var powers: Powers
var hand: GodHand

var volumes := {}
var muted := false
var amb := {}                 # layer -> AudioStreamPlayer
var amb_w := {}               # layer -> current linear weight
var amb_target := {}          # layer -> target linear weight
var murmur: AudioStreamPlayer3D
var _murmur_w := 0.0
var _murmur_target := 0.0
var voices: Array = []        # AudioStreamPlayer3D pool
var _streams := {}
var _last := {}               # cue -> last time played (anti-spam)
var _last_var := {}           # cue group -> last variant index (no immediate repeats)
var cue_counts := {}          # cue -> times played (tests / tuning)
var skipped := 0
var _t := 0.0
var _mix_t := 0.0
var _settle_t := 1.5
var _bird_t := 2.0
var _wolf_t := 25.0
var _rustle_t := 6.0
var _fire_t := 0.0
var _fires_seen := 0
var _brush: AudioStreamPlayer3D
var _brush_id := ""
var _brush_t := 0.0
var _brush_w := 0.0
var _fire_players: Array = []
var _rain: Array = []         # [{"p": player, "t": seconds left}]
var _music: AudioStreamPlayer
var _music_i := 0
var _music_wait := 30.0       # first piece after half a minute of play
var _music_fade := 0.0
var last_mix := {}            # most recent ambience analysis (debug / tests)

func setup(p_main) -> void:
	main = p_main
	sim = main.sim
	terrain = main.terrain
	rig = main.rig
	powers = main.powers
	hand = main.hand
	_setup_buses()
	load_settings()
	for layer in AMB_LAYERS:
		var p := AudioStreamPlayer.new()
		p.stream = _loop(_stream("ambience/%s.ogg" % layer))
		p.bus = "Ambience"
		p.volume_db = -80.0
		add_child(p)
		p.play(randf() * 10.0)
		amb[layer] = p
		amb_w[layer] = 0.0
		amb_target[layer] = 0.0
	murmur = _player3d("Ambience")
	murmur.stream = _loop(_stream("ambience/village.ogg"))
	murmur.unit_size = 16.0
	murmur.max_distance = 170.0
	murmur.volume_db = -80.0
	murmur.play()
	for i in VOICES:
		var v := _player3d("SFX")
		v.set_meta("cat", "")
		voices.append(v)
	_brush = _player3d("SFX")
	_brush.unit_size = 40.0
	_brush.max_distance = 400.0
	_brush.volume_db = -80.0
	for i in LIMITS["fire"]:
		var f := _player3d("SFX")
		f.stream = _loop(_stream("ambience/fire.ogg"))
		f.unit_size = 9.0
		f.max_distance = 140.0
		f.volume_db = -80.0
		_fire_players.append(f)
	_music = AudioStreamPlayer.new()
	_music.bus = "Music"
	add_child(_music)
	powers.cast_done.connect(_on_cast)
	powers.brush_cast.connect(_on_brush)
	powers.meteor_impact.connect(func(p): play("meteor_impact", p, "power", 0.0, 60.0))
	powers.power_changed.connect(func(_i): play_ui("ui_select"))
	hand.hand_event.connect(_on_hand)
	sim.impact.connect(_on_impact)
	sim.building_event.connect(_on_building)

# ------------------------------------------------------------------ buses / settings
func _setup_buses() -> void:
	for b in BUSES:
		if AudioServer.get_bus_index(b) == -1:
			AudioServer.add_bus()
			var i := AudioServer.bus_count - 1
			AudioServer.set_bus_name(i, b)
			AudioServer.set_bus_send(i, "Master")

func set_volume(bus: String, v: float) -> void:
	volumes[bus] = clampf(v, 0.0, 1.0)
	var i := AudioServer.get_bus_index(bus)
	if i >= 0:
		AudioServer.set_bus_volume_db(i, linear_to_db(maxf(volumes[bus], 0.0001)))
		AudioServer.set_bus_mute(i, volumes[bus] <= 0.001)
	save_settings()

func set_muted(on: bool) -> void:
	muted = on
	AudioServer.set_bus_mute(AudioServer.get_bus_index("Master"), on)
	save_settings()

func load_settings() -> void:
	var cf := ConfigFile.new()
	var ok := cf.load(CFG_PATH) == OK
	for b in DEFAULTS:
		volumes[b] = float(cf.get_value("volume", b, DEFAULTS[b])) if ok else DEFAULTS[b]
	muted = bool(cf.get_value("volume", "muted", false)) if ok else false
	for b in volumes:
		var i := AudioServer.get_bus_index(b)
		if i >= 0:
			AudioServer.set_bus_volume_db(i, linear_to_db(maxf(volumes[b], 0.0001)))
			AudioServer.set_bus_mute(i, volumes[b] <= 0.001)
	AudioServer.set_bus_mute(AudioServer.get_bus_index("Master"), muted)

func save_settings() -> void:
	if "--autotest" in OS.get_cmdline_user_args(): return   # tests never touch the player's settings
	var cf := ConfigFile.new()
	for b in volumes:
		cf.set_value("volume", b, volumes[b])
	cf.set_value("volume", "muted", muted)
	cf.save(CFG_PATH)

# ------------------------------------------------------------------ streams / voices
func _stream(rel: String) -> AudioStream:
	if not _streams.has(rel):
		_streams[rel] = load("res://assets/audio/" + rel)
	return _streams[rel]

func _loop(s: AudioStream) -> AudioStream:
	if s is AudioStreamOggVorbis:
		s.loop = true
	elif s is AudioStreamWAV:
		s.loop_mode = AudioStreamWAV.LOOP_FORWARD
		s.loop_begin = 0
		s.loop_end = int(s.get_length() * s.mix_rate)
	return s

func _player3d(bus: String) -> AudioStreamPlayer3D:
	var p := AudioStreamPlayer3D.new()
	p.bus = bus
	p.attenuation_model = AudioStreamPlayer3D.ATTENUATION_INVERSE_DISTANCE
	p.doppler_tracking = AudioStreamPlayer3D.DOPPLER_TRACKING_DISABLED
	add_child(p)
	return p

## Cue name -> variant files (picked at random, never the same twice in a row).
const CUES := {
	"bird": ["bird_01", "bird_02", "bird_03", "bird_04", "bird_05", "bird_06", "bird_07", "bird_08", "bird_09", "bird_10"],
	"wolf_howl": ["wolf_howl_1", "wolf_howl_2", "wolf_howl_3"],
	"rustle": ["rustle_1", "rustle_2", "rustle_3"],
	"chop": ["chop_1", "chop_2", "chop_3"],
	"hammer": ["hammer_1", "hammer_2", "hammer_3"],
	"hand_grab": ["hand_grab_1", "hand_grab_2"],
	"hand_place": ["hand_place_1", "hand_place_2"],
	"hand_throw": ["hand_throw_1", "hand_throw_2"],
}
## unit_size, max_distance, min interval (s), pitch jitter
const CUE_SPEC := {
	"bird": [7.0, 130.0, 0.4, 0.03], "wolf_howl": [30.0, 320.0, 6.0, 0.04], "rustle": [4.0, 60.0, 0.3, 0.08],
	"deer_huff": [6.0, 80.0, 1.0, 0.06], "rabbit_thump": [3.0, 50.0, 0.6, 0.08],
	"chop": [9.0, 150.0, 0.12, 0.06], "hammer": [9.0, 150.0, 0.12, 0.06], "build_complete": [12.0, 180.0, 0.5, 0.04],
	"collapse": [20.0, 260.0, 0.3, 0.05],
	"hand_grab": [25.0, 300.0, 0.08, 0.06], "hand_place": [25.0, 300.0, 0.08, 0.06], "hand_throw": [25.0, 300.0, 0.08, 0.08],
	"impact_light": [20.0, 280.0, 0.06, 0.08], "impact_heavy": [28.0, 320.0, 0.06, 0.06], "splash": [20.0, 280.0, 0.06, 0.08],
	"tile_thunk": [30.0, 350.0, 0.07, 0.07], "life": [40.0, 400.0, 0.3, 0.02], "forest_grow": [35.0, 400.0, 0.9, 0.05],
	"rain_gather": [45.0, 400.0, 0.5, 0.03], "plenty": [40.0, 400.0, 0.4, 0.02], "lightning": [70.0, 600.0, 0.12, 0.05],
	"meteor_incoming": [70.0, 600.0, 0.2, 0.03], "meteor_impact": [90.0, 700.0, 0.2, 0.03], "ignite": [15.0, 200.0, 0.5, 0.08],
}

func _free_voice(cat: String) -> AudioStreamPlayer3D:
	var busy := 0
	var idle: AudioStreamPlayer3D = null
	for v in voices:
		if v.playing:
			if v.get_meta("cat") == cat: busy += 1
		elif idle == null:
			idle = v
	if busy >= LIMITS.get(cat, 4):
		# the player's own actions must always be heard: replace the oldest
		# voice of the same kind instead of dropping the new cue
		if cat in ["power", "hand"]: return _oldest(cat)
		return null
	if idle != null: return idle
	# all voices busy: steal the oldest one of a less important category
	for v in voices:
		if v.get_meta("cat") in ["bird", "settle", "wild"] and cat in ["power", "hand"]:
			return v
	return null

func _oldest(cat: String) -> AudioStreamPlayer3D:
	var best: AudioStreamPlayer3D = null
	for v in voices:
		if v.playing and v.get_meta("cat") == cat and (best == null or v.get_meta("t0", 0.0) < best.get_meta("t0", 0.0)):
			best = v
	return best

## Plays a positional one-shot. Returns false when rate-limited or out of voices.
func play(cue: String, pos: Vector3, cat: String, from := 0.0, gain_db := 0.0, pitch := 1.0) -> bool:
	var spec: Array = CUE_SPEC.get(cue, [15.0, 250.0, 0.1, 0.05])
	if _t - _last.get(cue, -100.0) < spec[2]:
		return false
	var v := _free_voice(cat)
	if v == null:
		skipped += 1
		return false
	_last[cue] = _t
	var file := cue
	if CUES.has(cue):
		var opts: Array = CUES[cue]
		var k := randi() % opts.size()
		if opts.size() > 1 and k == _last_var.get(cue, -1):
			k = (k + 1) % opts.size()
		_last_var[cue] = k
		file = opts[k]
	v.stream = _stream("sfx/%s.wav" % file)
	v.set_meta("cat", cat)
	v.set_meta("t0", _t)
	v.unit_size = spec[0]
	v.max_distance = spec[1]
	v.pitch_scale = pitch * (1.0 + randf_range(-spec[3], spec[3]))
	v.volume_db = gain_db
	v.global_position = pos
	v.play(from)
	cue_counts[cue] = cue_counts.get(cue, 0) + 1
	return true

func play_ui(cue: String) -> void:
	if _t - _last.get(cue, -100.0) < 0.08: return
	_last[cue] = _t
	var p := AudioStreamPlayer.new()
	p.stream = _stream("sfx/%s.wav" % cue)
	p.bus = "SFX"
	add_child(p)
	p.finished.connect(p.queue_free)
	p.play()
	cue_counts[cue] = cue_counts.get(cue, 0) + 1

# ------------------------------------------------------------------ game events
func _on_cast(id: String, p: Vector3) -> void:
	match id:
		"land": play("tile_thunk", p, "power")
		"villager": play("life", p, "power")
		"rain":
			play("rain_gather", p + Vector3(0, 10, 0), "power")
			_start_rain(p)
		"plenty": play("plenty", p, "power")
		"lightning": play("lightning", p, "power")
		"meteor":
			# the rock lands 1.1 s after the cast; the roar is built to peak then
			play("meteor_incoming", p + Vector3(-12, 20, -9), "power", 0.25)

func _on_brush(id: String, p: Vector3) -> void:
	if id == "forest":
		play("forest_grow", p, "power")
		return
	var file := "sfx/drain_loop.wav" if id == "remove" else "sfx/earth_rumble_loop.wav"
	if _brush_id != id:
		_brush_id = id
		_brush.stream = _loop(_stream(file))
		_brush.pitch_scale = {"land": 1.0, "raise": 1.12, "lower": 0.84, "remove": 1.0}.get(id, 1.0)
		_brush.play()
		cue_counts["brush_" + id] = cue_counts.get("brush_" + id, 0) + 1
	elif not _brush.playing:
		_brush.play()
	_brush.global_position = p
	_brush_t = 0.2

func _start_rain(p: Vector3) -> void:
	var r := _player3d("SFX")
	r.stream = _loop(_stream("ambience/rain.ogg"))
	r.unit_size = 22.0
	r.max_distance = 260.0
	r.volume_db = -40.0
	r.global_position = p + Vector3(0, 4, 0)
	r.play(randf() * 8.0)
	_rain.append({"p": r, "t": 8.0, "age": 0.0})
	cue_counts["rain_loop"] = cue_counts.get("rain_loop", 0) + 1

func _on_hand(kind: String, p: Vector3, _what: String) -> void:
	match kind:
		"grab": play("hand_grab", p, "hand")
		"place": play("hand_place", p, "hand")
		"throw": play("hand_throw", p, "hand")

func _on_impact(p: Vector3, speed: float, _kind: String) -> void:
	if p.y < Terrain.SEA - 0.2 or not terrain.is_land(p.x, p.z):
		if speed > 4.0: play("splash", p, "hand")
	elif speed > 15.0:
		play("impact_heavy", p, "hand")
	elif speed > 6.0:
		play("impact_light", p, "hand", 0.0, -3.0)

func _on_building(kind: String, p: Vector3) -> void:
	if kind == "complete":
		play("build_complete", p, "settle")
	else:
		play("collapse", p, "power")

# ------------------------------------------------------------------ per frame
func _process(dt: float) -> void:
	_t += dt
	var paused: bool = main.speed_idx == 0
	_mix_t -= dt
	if _mix_t <= 0.0:
		_mix_t = 0.25
		_analyse()
	# smooth ambience fades (~1.5 s time constant: no abrupt changes)
	var k := 1.0 - exp(-dt / 1.5)
	for layer in amb:
		amb_w[layer] = lerpf(amb_w[layer], amb_target[layer], k)
		var w: float = amb_w[layer] * (0.7 if paused else 1.0)
		amb[layer].volume_db = linear_to_db(maxf(w, 0.0001)) + AMB_LAYERS[layer]
	_murmur_w = lerpf(_murmur_w, 0.0 if paused else _murmur_target, k)
	murmur.volume_db = linear_to_db(maxf(_murmur_w, 0.0001)) - 2.0
	# brush rumble: fade in while the brush works, out shortly after it stops
	_brush_t -= dt
	_brush_w = lerpf(_brush_w, 1.0 if _brush_t > 0.0 else 0.0, 1.0 - exp(-dt / (0.08 if _brush_t > 0.0 else 0.25)))
	_brush.volume_db = linear_to_db(maxf(_brush_w, 0.0001)) - 4.0
	if _brush_w < 0.002 and _brush.playing:
		_brush.stop()
		_brush_id = ""
	_update_rain(dt)
	_update_fires(dt)
	_update_music(dt)
	if paused: return
	_settlements(dt)
	_wildlife(dt)

## What does the camera see? Samples land / water around the focus, tree
## density and zoom, and sets the ambience layer targets from it.
func _analyse() -> void:
	var f: Vector3 = rig.focus
	var d: float = rig.dist
	var r := clampf(d * 0.55, 10.0, 80.0)
	var water := 0
	var n := 0
	for i in 16:
		var a := TAU * i / 16.0
		for rr in [0.35, 0.8]:
			var q: Vector3 = f + Vector3(cos(a), 0, sin(a)) * r * rr
			n += 1
			if not terrain.is_land(q.x, q.z): water += 1
	if not terrain.is_land(f.x, f.z): water += 2
	var wf := float(water) / (n + 2)
	var trees := 0
	var near_r := minf(r, 40.0)
	for res in sim.resources_in_radius(f, near_r):
		if res.type == WorldSim.RES_TREE: trees += 1
	var density := trees / (PI * near_r * near_r)
	var forest := clampf(density / 0.035, 0.0, 1.0)
	var alt := smoothstep(70.0, 190.0, d)
	var shore := 1.0 - absf(wf - 0.45) * 2.0
	var coast := clampf(maxf(shore, 0.0) * 1.1 + wf * 0.5, 0.0, 1.0)
	var land := 1.0 - wf
	amb_target["coast"] = coast * (1.0 - alt * 0.55)
	amb_target["forest"] = forest * land * (1.0 - alt * 0.75)
	amb_target["meadow"] = clampf((1.0 - forest) * land * 0.85, 0.0, 1.0) * (1.0 - alt * 0.75)
	amb_target["high_wind"] = 0.15 + alt * 0.85
	last_mix = {"water": wf, "forest": forest, "alt": alt, "coast": amb_target["coast"]}
	# village murmur at the nearest settlement in earshot
	var best = null
	var bd := INF
	for t in sim.live_tribes():
		var dd: float = Vector2(t.center.x - f.x, t.center.z - f.z).length()
		if dd < bd:
			bd = dd
			best = t
	if best != null and d < 120.0 and bd < r + 25.0:
		murmur.global_position = best.center + Vector3(0, 1, 0)
		_murmur_target = clampf(best.members.size() / 25.0, 0.25, 1.0)
	else:
		_murmur_target = 0.0

func _settlements(dt: float) -> void:
	_settle_t -= dt
	if _settle_t > 0.0: return
	_settle_t = randf_range(0.35, 0.8)
	if rig.dist > 130.0: return
	var f: Vector3 = rig.focus
	var hear := clampf(rig.dist * 0.6, 18.0, 60.0)
	var workers: Array = []
	for v in sim.villagers:
		if v.dead: continue
		if v.state != Villager.S.BUILD and v.state != Villager.S.GATHER: continue
		if Vector2(v.position.x - f.x, v.position.z - f.z).length() < hear:
			workers.append(v)
	if workers.is_empty(): return
	var w: Villager = workers[randi() % workers.size()]
	if randf() > clampf(0.25 + workers.size() * 0.05, 0.0, 0.6): return
	if w.state == Villager.S.BUILD:
		play("hammer", w.position, "settle", 0.0, -2.0)
	elif w.res != null and w.res.type == WorldSim.RES_TREE:
		play("chop", w.position, "settle", 0.0, -2.0)
	elif w.res != null and w.res.type == WorldSim.RES_ROCK:
		# quarrying: a lower, duller strike than a mallet on timber
		play("hammer", w.position, "settle", 0.0, -4.0, 0.62)

func _wildlife(dt: float) -> void:
	var f: Vector3 = rig.focus
	var d: float = rig.dist
	_bird_t -= dt
	if _bird_t <= 0.0:
		_bird_t = randf_range(3.0, 9.0)
		var raining := false
		for r in _rain:
			if Vector2(r["p"].global_position.x - f.x, r["p"].global_position.z - f.z).length() < 30.0: raining = true
		if d < 150.0 and not raining and amb_target["forest"] + amb_target["meadow"] > 0.25:
			var trees: Array = []
			for res in sim.resources_in_radius(f, clampf(d * 0.5, 15.0, 50.0)):
				if res.type == WorldSim.RES_TREE: trees.append(res)
			if trees.size() >= 3:
				var t = trees[randi() % trees.size()]
				play("bird", t.pos + Vector3(0, 3.0, 0), "bird", 0.0, -3.0 if amb_target["forest"] > 0.5 else -5.0)
	_wolf_t -= dt
	if _wolf_t <= 0.0:
		_wolf_t = randf_range(35.0, 80.0)
		var wolves: Array = []
		for a in sim.eco.animals:
			if a.species == "wolf" and not a.dead and Vector2(a.position.x - f.x, a.position.z - f.z).length() < 110.0:
				wolves.append(a)
		if not wolves.is_empty():
			var w = wolves[randi() % wolves.size()]
			play("wolf_howl", w.position + Vector3(0, 1, 0), "wild", 0.0, -2.0)
	_rustle_t -= dt
	if _rustle_t <= 0.0:
		_rustle_t = randf_range(3.0, 7.0)
		if d < 55.0:
			var near: Array = []
			for a in sim.eco.animals:
				if a.dead or a.species == "bird" or a.species == "wolf": continue
				if Vector2(a.position.x - f.x, a.position.z - f.z).length() < 26.0 and a.state in [Animal.S.WANDER, Animal.S.FLEE, Animal.S.GRAZE]:
					near.append(a)
			if not near.is_empty():
				var a = near[randi() % near.size()]
				if a.state == Animal.S.FLEE and a.species == "deer" and randf() < 0.5:
					play("deer_huff", a.position, "wild", 0.0, -4.0)
				elif a.species == "rabbit" and randf() < 0.4:
					play("rabbit_thump", a.position, "wild", 0.0, -6.0)
				else:
					play("rustle", a.position, "wild", 0.0, -3.0)

func _update_rain(dt: float) -> void:
	for r in _rain.duplicate():
		r["t"] -= dt
		r["age"] += dt
		var p: AudioStreamPlayer3D = r["p"]
		var w := clampf(r["age"] / 1.2, 0.0, 1.0) * clampf(r["t"] / 1.5, 0.0, 1.0)
		p.volume_db = linear_to_db(maxf(w, 0.0001))
		if r["t"] <= 0.0:
			p.queue_free()
			_rain.erase(r)

func _update_fires(dt: float) -> void:
	_fire_t -= dt
	if _fire_t > 0.0:
		for fp in _fire_players:
			fp.volume_db = lerpf(fp.volume_db, fp.get_meta("target", -80.0), 1.0 - exp(-dt / 0.5))
		return
	_fire_t = 0.5
	var f: Vector3 = rig.focus
	var fires: Array = []
	for fi in sim.fires:
		var pos: Vector3 = fi["res"].pos if fi["res"] != null else fi["bld"].pos
		fires.append(pos)
	if fires.size() > _fires_seen and not fires.is_empty():
		play("ignite", fires[fires.size() - 1], "power", 0.0, -3.0)
	_fires_seen = fires.size()
	fires.sort_custom(func(a, b): return a.distance_squared_to(f) < b.distance_squared_to(f))
	for i in _fire_players.size():
		var fp: AudioStreamPlayer3D = _fire_players[i]
		if i < fires.size() and fires[i].distance_to(f) < 120.0:
			fp.global_position = fires[i] + Vector3(0, 1, 0)
			fp.set_meta("target", -2.0)
			if not fp.playing: fp.play(randf() * 6.0)
		else:
			fp.set_meta("target", -80.0)
			if fp.playing and fp.volume_db < -60.0: fp.stop()

## Music: a quiet piece every few minutes with silence between, never constant.
func _update_music(dt: float) -> void:
	if _music.playing:
		_music_fade = minf(_music_fade + dt / 4.0, 1.0)
		_music.volume_db = linear_to_db(maxf(_music_fade, 0.0001)) - 3.0
		return
	_music_wait -= dt
	if _music_wait <= 0.0 and volumes.get("Music", 0.0) > 0.001:
		_music.stream = _stream("music/%s.ogg" % MUSIC[_music_i % MUSIC.size()])
		_music_i += 1
		_music_fade = 0.0
		_music.volume_db = -80.0
		_music.play()
		cue_counts["music"] = cue_counts.get("music", 0) + 1
		_music_wait = randf_range(90.0, 180.0)

func busy_voices() -> int:
	var n := 0
	for v in voices:
		if v.playing: n += 1
	return n
